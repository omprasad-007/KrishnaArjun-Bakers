rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read on products
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Allow users to read and update their own user documents
    match /users/{userId} {
      allow read, write: if true;
    }

    // Orders collection
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Bulk orders collection
    match /bulkOrders/{bulkOrderId} {
      allow read, write: if true;
    }

    // Inventory transactions
    match /inventoryTransactions/{txId} {
      allow read, write: if true;
    }

    // Digital bills
    match /bills/{billId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Real-time chat
    match /conversations/{conversationId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Fallback for any other collection
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
